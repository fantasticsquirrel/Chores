# Family Manager password-reset proxy fragment — APPROVAL-GATED TEMPLATE ONLY.
#
# Place limit_req_zone directives in nginx http{} context. Place real_ip and
# location directives in the active HTTPS server{} for family.multihost.ing.
# Replace every placeholder only after proxy topology and the existing chore
# upstream have been verified. Do not use this file as a direct include unchanged.

# http{} context
limit_req_zone $binary_remote_addr zone=family_manager_password_reset_request:10m rate=5r/m;
limit_req_zone $binary_remote_addr zone=family_manager_password_reset_confirm:10m rate=12r/m;

# HTTPS server{} context: only the known edge proxy may rewrite client address.
real_ip_header X-Forwarded-For;
set_real_ip_from __REPLACE_WITH_TRUSTED_PROXY_CIDR__;
real_ip_recursive on;

# These named fallbacks preserve the public endpoint contracts when the coarse
# edge limit trips. No account-specific rate information or Retry-After header
# is exposed; persistent abuse policy remains in the application database.
location @family_manager_password_reset_request_limited {
    internal;
    default_type application/json;
    add_header Cache-Control "no-store" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Content-Type-Options "nosniff" always;
    return 202 '{"detail":"If an eligible account exists for that address, reset instructions will arrive shortly."}';
}

location @family_manager_password_reset_confirm_limited {
    internal;
    default_type application/json;
    add_header Cache-Control "no-store" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Content-Type-Options "nosniff" always;
    return 202 '{"detail":"Try signing in. If you cannot sign in, request a new reset link."}';
}

location = /chore-api/auth/password-reset/request {
    client_max_body_size 2k;
    limit_req zone=family_manager_password_reset_request burst=5 nodelay;
    limit_req_status 429;
    error_page 429 = @family_manager_password_reset_request_limited;
    proxy_pass http://__REPLACE_WITH_FAMILY_MANAGER_UPSTREAM__;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $realip_remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

location = /chore-api/auth/password-reset/confirm {
    client_max_body_size 2k;
    limit_req zone=family_manager_password_reset_confirm burst=8 nodelay;
    limit_req_status 429;
    error_page 429 = @family_manager_password_reset_confirm_limited;
    proxy_pass http://__REPLACE_WITH_FAMILY_MANAGER_UPSTREAM__;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $realip_remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

# This exact route must stay free of analytics, third-party assets, and cache.
# It restates all security headers because Nginx add_header inheritance changes
# whenever an inner location defines a header.
location = /chore/reset-password {
    try_files $uri /chore/index.html;
    add_header Cache-Control "no-store" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self';" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
}

# Preserve the same document policy if a client reaches the harmless trailing
# slash variant. This block must remain exact, rather than broadening API paths.
location = /chore/reset-password/ {
    try_files $uri /chore/index.html;
    add_header Cache-Control "no-store" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self';" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
}
