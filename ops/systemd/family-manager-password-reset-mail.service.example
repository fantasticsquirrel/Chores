[Unit]
Description=Deliver queued Family Manager password-reset security mail
After=network-online.target postfix.service opendkim.service
Wants=network-online.target
ConditionPathIsExecutable=/usr/sbin/sendmail

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=__REPLACE_WITH_APPLICATION_BACKEND_DIRECTORY__
EnvironmentFile=/etc/family-manager/password-reset-mail.env
ExecStart=__REPLACE_WITH_APPLICATION_VENV_PYTHON__ -m scripts.process_password_reset_mail --batch-size=25 --cleanup --log-counts-only
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
UMask=0077
ReadWritePaths=__REPLACE_WITH_APPLICATION_STATE_DIRECTORY__ /var/spool/postfix/maildrop /var/spool/postfix/public
StandardOutput=journal
StandardError=journal
