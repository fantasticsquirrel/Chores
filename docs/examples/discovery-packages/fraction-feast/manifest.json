  "exploration": {
    "id": "fraction-feast-package",
    "title": "Fraction Feast",
    "subject": "Mathematics",
    "grade_bands": [
      "3-5"
    ],
    "tags": [
      "fractions",
      "equivalence",
      "addition",
      "number-sense"
    ],
    "summary": "Divide equal-sized plates into equal parts, compare portions and combine fractions.",
    "question": "How can two different fractions describe the same amount?",
    "explanation": "A fraction describes equal parts of a whole. The denominator tells how many equal parts make the whole; the numerator counts the parts selected. One half and two quarters cover the same amount of an equal-sized plate. To add fractions with different denominators, describe them using equal-sized pieces first. Every plate here represents the same whole, and every cut makes equal portions. The total can be greater than one plate.",
    "experiments": [
      {
        "title": "Different pieces, same portion",
        "instruction": "Show 1/2 on plate A and 2/4 on plate B. Predict whether they cover the same amount, then split every slice on one plate.",
        "observe": "The pieces get smaller and more numerous, but the selected amount stays the same. Explain why doubling both numerator and denominator preserves the fraction."
      },
      {
        "title": "Combine unlike pieces",
        "instruction": "Select 2/3 on one plate and 3/4 on the other. Predict whether the total is below, equal to or above one whole, then compare the combined total.",
        "observe": "Compare the total, 17/12, with one whole. Explain how 8/12 plus 9/12 represents the same portions using equal-sized twelfths."
      }
    ],
    "misconception": "A larger denominator does not automatically mean more food. With the same whole and numerator, more equal parts make each selected part smaller.",
    "sources": [
      {
        "title": "Illustrative Mathematics: Fraction equivalence and comparison",
        "url": "https://tasks.illustrativemathematics.org/content-standards/3/NF/A/3"
      }
    ],
    "duration_minutes": 12
  },
