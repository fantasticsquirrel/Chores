  "exploration": {
    "id": "fraction-feast-package",
    "title": "Fraction Feast",
    "subject": "Mathematics",
    "grade_bands": [
      "3-5"
    ],
    "tags": [
      "fractions",
      "equivalence",
      "addition",
      "number-sense"
    ],
    "summary": "Hold the whole area fixed, compare equal partitions and add fractions with an exact shared unit.",
    "question": "How do piece size and piece count work together when fractions are equivalent or added?",
    "explanation": "A fraction describes equal parts of a whole. The denominator tells how many equal pieces make that whole; the numerator counts selected pieces. Comparisons are fair only when the wholes have the same area. One half and two quarters cover the same amount because doubling the piece count makes each piece half as large. To add fractions with different denominators, first rename both portions with a common-sized piece. The exact total may be greater than one whole.",
    "experiments": [
      {
        "title": "Different pieces, same portion",
        "instruction": "Keep the whole area and selected area fixed. Show 1/2 on plate A, predict what changes when every piece is split in two, then compare with 2/4.",
        "observe": "The selected piece count doubles while each piece becomes half as large; 1/2 and 2/4 cover the same area. Explain why changing both numerator and denominator by the same factor preserves the amount."
      },
      {
        "title": "Combine unlike pieces",
        "instruction": "Use equal-area wholes. Select 2/3 and 3/4, predict whether their sum fits in one whole, then combine the portions using equal twelfths.",
        "observe": "The exact conversion is 8/12 + 9/12 = 17/12, or 1 whole and 5/12. Explain why the numerators add while the common denominator stays 12."
      }
    ],
    "misconception": "A larger denominator does not automatically mean more food. With the same whole and numerator, more equal parts make each selected part smaller.",
    "sources": [
      {
        "title": "Common Core State Standards: fraction equivalence, common wholes and visual models",
        "url": "https://corestandards.org/wp-content/uploads/2023/09/ADA-Compliant-Math-Standards.pdf"
      },
      {
        "title": "OpenStax Prealgebra 2e: Visualize Fractions",
        "url": "https://openstax.org/books/prealgebra-2e/pages/4-1-visualize-fractions"
      },
      {
        "title": "OpenStax Prealgebra 2e: Add and Subtract Fractions with Different Denominators",
        "url": "https://openstax.org/books/prealgebra-2e/pages/4-5-add-and-subtract-fractions-with-different-denominators"
      }
    ],
    "duration_minutes": 12
  },
