{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "noEmit": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true
  },
  "include": ["vite.config.ts", "playwright.smoke.config.ts", "scripts/**/*.ts"]
}
