{
  "name": "chore_tracking",
  "version": "1.0.8",
  "private": true,
  "engines": {
    "node": ">=20.19.4 <21"
  },
  "workspaces": [
    "frontend",
    "mobile",
    "packages/*"
  ],
  "overrides": {
    "@expo/cli": {
      "glob": "14.0.2",
      "node-forge": "1.4.2",
      "zod": "4.6.7"
    },
    "@expo/code-signing-certificates": {
      "node-forge": "1.4.2"
    },
    "@expo/config": {
      "deepmerge": "4.3.1",
      "glob": "14.0.2"
    },
    "@expo/config-plugins": {
      "glob": "14.0.2"
    },
    "@expo/fingerprint": {
      "glob": "14.0.2",
      "minimatch": "11.0.1"
    },
    "@expo/metro-config": {
      "glob": "14.0.2"
    },
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "4.3.2"
    },
    "babel-plugin-istanbul": {
      "test-exclude": {
        ".": "8.0.0",
        "glob": "14.0.2",
        "minimatch": "11.0.1"
      }
    },
    "metro": "0.84.5",
    "metro-config": "0.84.5",
    "metro-transform-worker": "0.84.5",
    "xcode": {
      "uuid": "^11.1.1"
    }
  },
  "scripts": {
    "postinstall": "node scripts/security-backports.mjs && node scripts/verify-secure-upstream-artifacts.mjs",
    "security:backports": "node scripts/security-backports.mjs --check && node scripts/verify-secure-upstream-artifacts.mjs && node --test scripts/security-backports.test.mjs scripts/security-backports-installer.test.mjs scripts/verify-secure-upstream-artifacts.test.mjs scripts/security-upstream-consumers.test.mjs",
    "architecture:report": "python3 scripts/architecture-report.py",
    "shared-api:gate": "vitest run packages/family-api/src --environment node --maxWorkers=2",
    "family-tree-core:gate": "npm run typecheck --workspace @family-manager/family-tree-core && npm run test --workspace @family-manager/family-tree-core",
    "modules:validate": "vitest run packages/family-api/src/module-manifest-validator.test.ts packages/family-api/src/module-integrations.test.ts --environment node",
    "lint": "npm run lint --workspace frontend",
    "test": "npm run test --workspace frontend",
    "build": "npm run build --workspace frontend",
    "mobile:start": "npm run start --workspace mobile",
    "mobile:android": "npm run android --workspace mobile",
    "mobile:ios": "npm run ios --workspace mobile",
    "mobile:typecheck": "npm run typecheck --workspace mobile",
    "mobile:test": "npm run test --workspace mobile",
    "mobile:gate": "npm run mobile:typecheck && npm run mobile:test && npm run check:dependencies --workspace mobile",
    "mobile:apk": "npm run apk --workspace mobile",
    "mobile:apk:local": "npm run apk:local --workspace mobile",
    "mobile:eas:init": "npm run eas:init --workspace mobile",
    "mobile:eas:set-api": "npm run eas:set-api --workspace mobile --",
    "mobile:eas:whoami": "npm run eas:whoami --workspace mobile"
  },
  "devDependencies": {
    "vite": "^6.4.3",
    "vitest": "^4.1.8"
  }
}
