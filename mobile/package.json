{
  "name": "@family-manager/mobile",
  "version": "1.0.13",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~56.0.21",
    "@family-manager/discovery-scenes": "file:../packages/discovery-scenes",
    "@family-manager/family-api": "file:../packages/family-api",
    "@family-manager/family-tree-core": "file:../packages/family-tree-core",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~56.0.24",
    "expo-constants": "~56.0.27",
    "expo-device": "~56.0.4",
    "expo-document-picker": "~56.0.4",
    "expo-file-system": "~56.0.11",
    "expo-image-picker": "~56.0.25",
    "expo-modules-core": "~56.0.27",
    "expo-notifications": "~56.0.26",
    "expo-print": "~56.0.4",
    "expo-sharing": "~56.0.27",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/react-native": "^13.3.3",
    "@types/react": "~19.2.2",
    "esbuild": "0.25.12",
    "jest-expo": "~56.0.6",
    "react-test-renderer": "^19.2.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "check:dependencies": "expo install --check",
    "test:unit": "vitest run --environment node --exclude 'src/**/*.test.tsx'",
    "test:ui": "jest --runInBand",
    "test": "npm run test:unit && npm run test:ui",
    "apk": "bash ./scripts/build-apk.sh",
    "apk:local": "bash ./scripts/build-apk.sh --local",
    "eas:init": "npx --yes eas-cli@20.0.0 project:init",
    "eas:set-api": "bash ./scripts/set-eas-api-url.sh",
    "eas:whoami": "npx --yes eas-cli@20.0.0 whoami",
    "scenes:build": "node scripts/build-discovery-scenes.mjs",
    "scenes:check": "node scripts/build-discovery-scenes.mjs --check",
    "scenes:test:browser": "node --test scripts/discovery-scenes/*.browser-check.mjs",
    "pretypecheck": "npm run scenes:check"
  },
  "private": true
}
